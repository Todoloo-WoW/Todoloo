<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <Frame name="TodolooSharingDialog" parent="UIParent" inherits="BackdropTemplate" mixin="TodolooSharingDialogMixin" frameStrata="DIALOG" toplevel="true" hidden="true" enableMouse="true">
        <Size x="540" y="340" />

        <Anchors>
            <Anchor point="CENTER" />
        </Anchors>

        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Title" inherits="GameFontNormalLarge">
                    <Size x="460" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="24" y="-22" />
                    </Anchors>
                </FontString>

                <FontString parentKey="Help" inherits="GameFontHighlightSmall" justifyH="LEFT">
                    <Size x="490" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="24" y="-52" />
                    </Anchors>
                </FontString>

                <FontString parentKey="Status" inherits="GameFontHighlightSmall" justifyH="LEFT">
                    <Size x="490" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="24" y="48" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button parentKey="CloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-4" y="-4" />
                </Anchors>
            </Button>

            <ScrollFrame parentKey="ScrollFrame" 
                         inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="24" y="-100" />
                    <Anchor point="BOTTOMRIGHT" x="-44" y="85" />
                </Anchors>

                <ScrollChild>
                    <EditBox parentKey="EditBox" multiLine="true" autoFocus="false">
                        <Size x="465" y="150" />
                        <FontString inherits="ChatFontNormal" />
                    </EditBox>
                </ScrollChild>
            </ScrollFrame>

            <Button parentKey="BottomCloseButton" inherits="UIPanelButtonTemplate" text="CLOSE">
                <Size x="80" y="24" />
                <Anchors>
                    <Anchor point="BOTTOM" y="18" />
                </Anchors>
            </Button>

            <Button parentKey="ImportButton" inherits="UIPanelButtonTemplate" text="TODOLOO_L_SHARE_IMPORT">
                <Size x="140" y="24" />
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-24" y="18" />
                </Anchors>
            </Button>
        </Frames>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnHide method="OnHide" />
        </Scripts>
    </Frame>
</Ui>